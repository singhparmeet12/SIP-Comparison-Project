{
  "name": "Light & Colorful - SIP Dashboard",
  "dataColors": [
    "#4C6EF5",
    "#F59F00",
    "#0CA678",
    "#E64980",
    "#7950F2",
    "#22B8CF",
    "#FF6B6B",
    "#82C91E",
    "#FD7E14",
    "#15AABF",
    "#BE4BDB",
    "#ADB5BD"
  ],
  "background": "#FBFAF9",
  "secondaryBackground": "#F1F3F5",
  "foreground": "#343A40",
  "tableAccent": "#4C6EF5",
  "good": "#0CA678",
  "neutral": "#F59F00",
  "bad": "#E64980",
  "maximum": "#4C6EF5",
  "center": "#C5CFF7",
  "minimum": "#FBFAF9",
  "null": "#DEE2E6",
  "hyperlink": "#4C6EF5",
  "visitedHyperlink": "#7950F2",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#212529"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#343A40"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#495057"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#495057"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E9ECEF"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontColor": {
              "solid": {
                "color": "#343A40"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "transparency": 40
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FBFAF9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FBFAF9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#868E96"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "markers": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#868E96"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "axisLine": true,
            "axisLineColor": {
              "solid": {
                "color": "#DEE2E6"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#868E96"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#F1F3F5"
              }
            },
            "gridlineWeight": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#495057"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#495057"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#343A40"
              }
            },
            "textSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#495057"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F1F3F5"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#E9ECEF"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#495057"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F8F9FA"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#343A40"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#343A40"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FCFCFD"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F1F3F5"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#E9ECEF"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#495057"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F8F9FA"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#343A40"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#343A40"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FCFCFD"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#3B5BDB"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#EDF0FE"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#C5CFF7"
              }
            },
            "weight": 1
          }
        ]
      }
    }
  }
}