            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "markers": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "axisLine": true,
            "axisLineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "gridlineWeight": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
