        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F0FDF4"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#DCFCE7"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 8,
            "outlineColor": {
              "solid": {
                "color": "#86EFAC"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#166534"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCFCE7"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F0FDF4"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#166534"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
