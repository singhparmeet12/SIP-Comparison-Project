      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C1917"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C1917"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#292524"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#57534E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D1FAE5"
              }
            },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontColor": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "transparency": 40
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FBFBF9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FBFBF9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
