{
  "name": "Aesthetic Matcha & Warm Honey",
  "dataColors": [
    "#16A34A",
    "#D97706",
    "#0284C7",
    "#E11D48",
    "#7C3AED",
    "#059669",
    "#EA580C",
    "#4F46E5",
    "#65A30D",
    "#9333EA"
  ],
  "background": "#FBFBF9",
  "secondaryBackground": "#F0FDF4",
  "foreground": "#1C1917",
  "tableAccent": "#16A34A",
  "good": "#16A34A",
  "neutral": "#D97706",
  "bad": "#E11D48",
  "maximum": "#16A34A",
  "center": "#BBF7D0",
  "minimum": "#FBFBF9",
  "null": "#D6D3D1",
