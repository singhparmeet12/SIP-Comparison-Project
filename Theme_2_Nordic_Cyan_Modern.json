{
  "name": "Nordic Cyan & Modern",
  "dataColors": [
    "#0284C7",
    "#D97706",
    "#0D9488",
    "#7C3AED",
    "#E11D48",
    "#059669",
    "#F97316",
    "#4F46E5",
    "#65A30D",
    "#0891B2"
  ],
  "background": "#EEF2F6",
  "secondaryBackground": "#E2E8F0",
  "foreground": "#0F172A",
  "tableAccent": "#0284C7",
  "good": "#0D9488",
  "neutral": "#D97706",
  "bad": "#E11D48",
  "maximum": "#0284C7",
  "center": "#BAE6FD",
  "minimum": "#EEF2F6",
  "null": "#CBD5E1",
  "hyperlink": "#0284C7",
  "visitedHyperlink": "#7C3AED",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D0DCE5"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "transparency": 40
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "markers": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "axisLine": true,
            "axisLineColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridlineWeight": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "textSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#0369A1"
              }
            },
            "background": {
              "solid": {
                "color": "#F0F9FF"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 7,
            "outlineColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0369A1"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E0F2FE"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F0FDFA"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 7,
            "outlineColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0369A1"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E0F2FE"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F0FDFA"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0369A1"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#E0F2FE"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#BAE6FD"
              }
            },
            "weight": 1
          }
        ]
      }
    }
  }
}