{
  "name": "Executive Wealth & Warm Gold",
  "dataColors": [
    "#1E3A8A",
    "#D97706",
    "#059669",
    "#BE185D",
    "#6D28D9",
    "#C2410C",
    "#0891B2",
    "#4B5563",
    "#15803D",
    "#B45309"
  ],
  "background": "#FBF9F5",
  "secondaryBackground": "#EFECE6",
  "foreground": "#1C1917",
  "tableAccent": "#D97706",
  "good": "#059669",
  "neutral": "#D97706",
  "bad": "#BE185D",
  "maximum": "#D97706",
  "center": "#FDE68A",
  "minimum": "#FBF9F5",
  "null": "#D6D3D1",
  "hyperlink": "#1E3A8A",
  "visitedHyperlink": "#6D28D9",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C1917"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C1917"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#292524"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#57534E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E7E5E4"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontColor": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "transparency": 40
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FBF9F5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FBF9F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#78716C"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "markers": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#78716C"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "axisLine": true,
            "axisLineColor": {
              "solid": {
                "color": "#D6D3D1"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#78716C"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E7E5E4"
              }
            },
            "gridlineWeight": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#292524"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#292524"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "textSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#92400E"
              }
            },
            "background": {
              "solid": {
                "color": "#FEF3C7"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E7E5E4"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 7,
            "outlineColor": {
              "solid": {
                "color": "#D6D3D1"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#78350F"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FEF3C7"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFDF7"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E7E5E4"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 7,
            "outlineColor": {
              "solid": {
                "color": "#D6D3D1"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#78350F"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FEF3C7"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C1917"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFDF7"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#78350F"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FEF3C7"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#FDE68A"
              }
            },
            "weight": 1
          }
        ]
      }
    }
  }
}